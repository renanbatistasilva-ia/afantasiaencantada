{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afantasiaencantada",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  // Gera o site antes de publicar. Vale para o deploy automático da Cloudflare,
  // que clona o repositório sem o `out/` (ele é ignorado no git), e também aqui:
  // impede que um `out/` velho suba no lugar do código atual.
  "build": {
    "command": "npm run build"
  },
  // Limpeza diária às 4h de São Paulo (7h UTC): apaga pedido que não virou festa
  // com mais de 12 meses, como a página de privacidade promete, e poda os
  // contadores com mais de 25 meses. Cron Trigger é gratuito e mora aqui, sem
  // passo no painel — confirmar no primeiro deploy, porque R2, Analytics Engine
  // e Zero Trust também "moravam aqui" e os três exigiram clique.
  "triggers": { "crons": ["0 7 * * *"] },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Só estas rotas passam pelo Worker. Todo o resto do site continua sendo
    // servido direto pela camada de assets, sem tocar em código.
    "run_worker_first": ["/api/*"]
  },
  // Freio para a rota de senha do painel. Fica fora do D1 de propósito: contar
  // tentativas no banco seria uma escrita por tentativa, e tentativa é coisa que
  // o atacante controla — esgotaria a cota diária e derrubaria a gravação de
  // leads. O freio viraria o ataque.
  "ratelimits": [
    { "name": "LIMITE_LOGIN", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_GLOBAL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_EVENTOS", "namespace_id": "1003", "simple": { "limit": 20, "period": 10 } }
  ],
  // O detalhe cru da navegação iria para a Analytics Engine — sem custo de cota
  // do D1 e apagado pela Cloudflare em 3 meses. Fica comentado porque ela exige
  // um clique de habilitação no painel, como o R2. Os contadores que o painel
  // mostra vivem no D1 e não dependem disto; o código já trata a ausência do
  // binding. Habilitou? Basta descomentar e publicar.
  // "analytics_engine_datasets": [{ "binding": "EVENTOS", "dataset": "fe_eventos" }],
  // Interruptor da contagem: "off" e um deploy desligam tudo.
  "vars": { "ANALITICA": "on" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantasia-leads",
      "database_id": "2c8a2086-d4f4-4201-87d1-f2d63d94f58f"
    }
  ]
}
