{
  "name": "fantasia-encantada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:painel": "wrangler dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "predeploy": "bash scripts/conferir-migracoes.sh",
  "deploy": "wrangler deploy",
    "senha": "bash scripts/senha.sh",
    "senha:conferir": "bash scripts/senha.sh --conferir",
    "sessoes:encerrar": "bash scripts/encerrar-sessoes.sh",
    "db:local": "wrangler d1 migrations apply fantasia-leads --local",
    "db:remoto": "wrangler d1 migrations apply fantasia-leads --remote",
    "db:pendentes": "wrangler d1 migrations list fantasia-leads --remote"
  },
  "dependencies": {
    "lenis": "^1.3.4",
    "motion": "^12.15.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.129.0"
  }
}
