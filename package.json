{
  "name": "fantasia-encantada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute fantasia-leads --local --file=worker/schema.sql",
    "db:remoto": "wrangler d1 execute fantasia-leads --remote --file=worker/schema.sql"
  },
  "dependencies": {
    "lenis": "^1.3.4",
    "motion": "^12.15.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.129.0"
  }
}
